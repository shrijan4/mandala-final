# Copy this file to .env and fill in real values before running in production.

PORT=3000

# Used to sign admin login tokens — set this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Credentials used ONLY the first time you run `npm run seed` to create the admin account.
# After that, log in at /admin and change your password from these defaults.
ADMIN_EMAIL=admin@mandala.com
ADMIN_PASSWORD=mandala2026

# Optional — enable real card payments via Stripe Checkout.
# Leave blank to keep the store running in "manual order" mode (orders are saved,
# no card is charged, useful while you're still setting up a Stripe account).
STRIPE_SECRET_KEY=
